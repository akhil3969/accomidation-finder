# Copy this file to backend/.env and put your own values in it.
# backend/.env is gitignored, so credentials never reach the repository.
#
#   cp backend/.env.example backend/.env
#
# The app reads it through `spring.config.import` in application.yml, so no
# `export` and no extra tooling is needed - just `mvn spring-boot:run`.

# --- Database (used by the dev and prod profiles) --------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=accommodation_finder
DB_USER=root
DB_PASSWORD=your-mysql-password

# --- Security --------------------------------------------------------
# Must be at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=paste-the-output-of-openssl-rand-base64-48-here
JWT_EXPIRATION_MS=86400000

# --- First admin (production) ---------------------------------------
# Creates an ADMIN account at startup if none exists yet. Use a fresh address
# and a password of 12+ characters, then delete these lines after first boot.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# --- Web -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080

# --- Choosing the profile --------------------------------------------
# NOT settable here. Spring Boot ignores spring.profiles.active when it comes
# from an imported config file, so putting SPRING_PROFILES_ACTIVE in this file
# silently does nothing and you get the in-memory H2 database instead of MySQL.
# Pick the profile on the command line:
#
#   mvn spring-boot:run                                  # demo, in-memory H2
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev   # MySQL
#
# or export it as a real environment variable before running:
#
#   export SPRING_PROFILES_ACTIVE=dev     # macOS / Linux
#   $env:SPRING_PROFILES_ACTIVE = "dev"   # Windows PowerShell
