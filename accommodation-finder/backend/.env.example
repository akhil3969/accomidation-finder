# Copy to .env and adjust, or export these in your shell before `mvn spring-boot:run`.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=accommodation_finder
DB_USER=root
DB_PASSWORD=root

# Must be at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-accommodation-finder-secret-key-2026
JWT_EXPIRATION_MS=86400000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080
